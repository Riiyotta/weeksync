        "initiallyOpenIndex": 0,
        "items": [
          {
            "question": "What is Brindlewick?",
            "answer": [
              {
                "paragraph": "A shift board for small kitchens. Cooks run down the side, days across the top, and every shift is a small card showing station and hours."
              }
            ]
          },
          {
            "question": "Does it work on the tablet by the pass?",
            "answer": [
              {
                "paragraph": "Yes. It runs in any current browser, so the tablet by the pass, the office laptop and a phone all show the same board."
              }
            ]
          },
          {
            "question": "How does billing work?",
            "answer": [
              {
                "paragraph": "One flat monthly price per active cook. There is no cap on stations or past weeks, and stopping takes a single click."
              }
            ]
          },
          {
            "question": "Can I see one cook across several stations?",
            "answer": [
              {
                "paragraph": "Yes. Next to every cook sits a live tally of booked hours, broken out by station, for example:"
              },
              {
                "list": [
                  "Hours per shift",
                  "Totals per week",
                  "Split by station",
                  "Hours left this week"
                ]
              }
            ]
          },
          {
            "question": "What if a night is short-staffed?",
            "answer": [
              {
                "paragraph": "The day summary changes colour as soon as a station is under-covered, so you can move a shift across before service."
              }
            ]
          },
          {
            "question": "Where is the data kept?",
            "answer": [
              {
                "paragraph": "Boards are encrypted at rest and backed up nightly. Nothing is resold, and a full export or wipe is one button away."
              }
            ]
          }
        ]
      },
