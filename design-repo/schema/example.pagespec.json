    {
      "section": "faq.accordion",
      "variant": "default",
      "content": {
        "title": "FAQ",
        "initiallyOpenIndex": 0,
        "items": [
          {
            "question": "What is Sevenday?",
            "answer": [
              {
                "paragraph": "Sevenday is a planning board for small teams built around weeks. Each person gets a row, each day a cell, and each task is a chip with its project and hours."
              }
            ]
          },
          {
            "question": "Do I need to install anything to get started?",
            "answer": [
              {
                "paragraph": "No. Sevenday runs in any modern browser on desktop or laptop, so there is nothing to download or configure. Create an account, add your teammates and projects, and you can start dragging work onto the board within a few minutes. Your data syncs on each change."
              }
            ]
          },
          {
            "question": "How is pricing done?",
            "answer": [
              {
                "paragraph": "You pay a flat monthly price for every active teammate on the board. Projects, boards and history are unlimited, and you can cancel at any time."
              }
            ]
          },
          {
            "question": "Can I see the hours of one person across many projects?",
            "answer": [
              {
                "paragraph": "Yes. Every person row shows a running total against their capacity, broken down by project, such as:"
              },
              {
                "list": [
                  "Totals per week",
                  "Hours per day",
                  "Breakdown by client",
                  "Capacity left for the week"
                ]
              },
              {
                "paragraph": "Totals turn orange at one hour over capacity and red at two, so you know where to look before the week gets away from anybody."
              }
            ]
          },
          {
            "question": "Is there a free trial?",
            "answer": [
              {
                "paragraph": "Yes. Every new workspace gets the full product free for fourteen days, with no card required up front. You can invite the whole team and plan real work during the trial."
              },
              {
                "paragraph": "When the trial ends you choose how many seats you need, or you simply stop using it and your data is deleted."
              }
            ]
          },
          {
            "question": "Can I plan in weeks rather than in days?",
            "answer": [
              {
                "paragraph": "Yes. Switch the view to Weeks and each column becomes a full week, with chips grouped by project and totals measured against forty hours per person, per week."
              }
            ]
          },
          {
            "question": "What happens if anyone is overbooked?",
            "answer": [
              {
                "paragraph": "The person total and the day summary change colour as soon as planned hours go above capacity, so it is easy to spot. From there you can fix it in a few sensible ways, for example:"
              },
              {
                "list": [
                  "Drag a chip to a teammate who still has free time that day",
                  "Move part of the work to a later day where there is still space",
                  "Split one long task into two smaller chips and spread them across the week so that no day overflows",
                  "Switch to the Weeks view to see whether the full week is over or just one day"
                ]
              }
            ]
          },
          {
            "question": "Can I add the whole team?",
            "answer": [
              {
                "paragraph": "Of course. Invite as many teammates as you like, and every person gets their own row on the board."
              }
            ]
          },
          {
            "question": "Is my planning data safe?",
            "answer": [
              {
                "paragraph": "Your boards are stored on encrypted servers in the EU, backed up every day, and never shared or sold. You can export or delete all of it anytime."
              }
            ]
          },
          {
            "question": "How do I contact the people behind it?",
            "answer": [
              {
                "paragraph": "Use the Telegram, X or Email buttons in the Get in touch card. Messages go straight to the developers, who reply within a day."
              }
            ]
          }
        ]
