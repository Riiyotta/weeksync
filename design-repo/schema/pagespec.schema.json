{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "weeksync-design-repo/pagespec.schema.json",
  "title": "PageSpec",
  "description": "A page composition built from this design-repo. mode=reference reconstructs the reference clone; mode=generated is a new page for someone else and may contain nothing that identifies or reproduces the source (enforced by schema/semantic_validate.py). maxWords is a custom annotation enforced by the semantic validator (Draft-07 ignores unknown keywords); maxLength carries the measured character budget.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageSpecVersion",
    "mode",
    "template",
    "route",
    "title",
    "brand",
    "theme",
    "nodes"
  ],
  "properties": {
    "pageSpecVersion": {
      "const": "1.0.0"
    },
    "mode": {
      "type": "string",
      "enum": [
        "reference",
        "generated"
      ]
    },
    "template": {
      "type": "string",
      "enum": [
        "template.loop-landing"
      ]
    },
    "route": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9/_.-]*$",
      "maxLength": 120
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 44,
      "maxWords": 7
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mark"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "mark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetRole"
          ],
          "properties": {
            "assetRole": {
              "type": "string",
              "enum": [
                "brand.reference-mark",
                "brand.placeholder-mark"
              ]
            },
            "src": {
              "type": "string",
              "maxLength": 200
            },
            "alt": {
              "type": "string",
              "maxLength": 120
            }
          }
        }
      }
    },
    "theme": {
      "type": "string",
      "enum": [
        "light"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "content_utility_cursor-trail": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "motion_utility_cursor-trail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "cursor-trail"
            ]
          }
        },
        "reducedMotionFallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cursor-trail"
          ],
          "properties": {
            "cursor-trail": {
              "const": "hidden"
            }
          }
        }
      }
    },
    "content_utility_cookie-consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "acceptLabel"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "maxWords": 20
        },
        "acceptLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "maxWords": 1
        }
      }
    },
    "motion_utility_cookie-consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "typewriter"
            ]
          }
        },
        "reducedMotionFallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "typewriter"
          ],
          "properties": {
            "typewriter": {
              "const": "full-text-static"
            }
          }
        }
      }
    },
    "content_shell_mobile-menu": {
