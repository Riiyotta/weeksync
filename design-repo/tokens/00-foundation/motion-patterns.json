{
  "$description": "Closed set of motion patterns a section may declare. Each pattern pins exactly one reducedMotionFallback (the schema const-locks it per pattern). sourceHonoursReducedMotion records what the reference build actually does today: only bot-cursors checks prefers-reduced-motion; the other fallbacks are requirements for pages built from this repo, not observed source behaviour.",
  "version": "1.0.0",
  "patterns": {
    "loop-scroll": {
      "kind": "page-scroll-model",
      "trigger": "wheel / touch / scrollTo events (desktop >= 1024 only)",
      "summary": "Fixed root, content rendered twice (wrap + wrap-clone), translate3d per frame; velocity += -deltaY*.25, friction .55; wraps at +-H; re-measures every 500px and on content resize.",
      "constants": {
        "speedFactor": 0.25,
        "friction": 0.55,
        "remeasureEveryPx": 500,
        "touchStepClampPx": 50
      },
      "evidence": [
        {
          "ref": "src/components/LoopScroller.jsx:9",
          "expect": "const SPEED_FACTOR = 0.25"
        },
        {
          "ref": "src/components/LoopScroller.jsx:10",
          "expect": "const FRICTION = 0.55"
        },
        {
          "ref": "src/components/LoopScroller.jsx:11",
          "expect": "const REMEASURE_EVERY = 500"
        },
        {
          "ref": "src/components/LoopScroller.jsx:12",
          "expect": "const TOUCH_STEP_CLAMP = 50"
        },
        {
          "ref": "src/components/LoopScroller.jsx:156",
          "expect": "data-loop-scroll=\"wrap-clone\""
        },
        {
          "ref": "CLONE_SPEC.md:384",
          "expect": "### 12.1 Loop scroller (desktop >= 1024 only)"
        }
      ],
      "reducedMotionFallback": "native-scroll-single-copy",
      "sourceHonoursReducedMotion": false
    },
    "smooth-scroll-to": {
      "kind": "programmatic-scroll",
      "trigger": "scissors button click (smooth: true); sidebar clicks pass smooth undefined = instant jump",
      "constants": {
        "durationMs": 1600,
        "easing": "easing.ease-in-out-quad",
        "path": "shortest path around the loop",
        "target": "section top measured from the page root inside the primary wrap, minus the root's padding-top (15rem), clamped at 0"
      },
      "evidence": [
        {
          "ref": "src/lib/motion.js:326",
          "expect": "export function startSmoothScroll({ delta, duration = 1600 })"
        },
        {
          "ref": "src/components/HeroSlide.jsx:73",
          "expect": "onClick={() => scrollToSection('features-section', { smooth: true })}"
        },
        {
          "ref": "src/components/Sidebar.jsx:87",
          "expect": "onClick={() => scrollToSection(item.target)}"
        },
        {
          "ref": "src/lib/loopEvents.js:24",
          "expect": "const pad = parseFloat(getComputedStyle(root).paddingTop) || 0"
        },
        {
          "ref": "src/lib/loopEvents.js:25",
          "expect": "const offset = Math.max(0, el.getBoundingClientRect().top - root.getBoundingClientRect().top - pad)"
        }
      ],
      "reducedMotionFallback": "instant-jump",
      "sourceHonoursReducedMotion": false
    },
